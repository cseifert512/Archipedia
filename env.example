# ============================================================
# Archipedia Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control!
# ============================================================

# ==================== API KEYS ====================

# OpenAI API Key (required for text search)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google Gemini API Key (required for AI generation features)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ==================== CLOUDFLARE R2 ====================
# (Required for image hosting in production)

R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=archipedia-images
R2_PUBLIC_URL=https://your-bucket.r2.dev

# ==================== BACKEND SERVER ====================

# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# CORS - comma-separated list of allowed origins
# Use * for development, specific domains for production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional auth token for protected routes (legacy, prefer Clerk)
# STUDY_TOKEN=your-secure-token-here

# ==================== CLERK AUTHENTICATION ====================
# Get your keys from: https://dashboard.clerk.com
# 
# 1. Create a Clerk account at https://clerk.com
# 2. Create a new application  
# 3. Go to API Keys in the dashboard
# 4. Copy the keys below

# Backend: Clerk Frontend API URL (for JWT verification)
# Format: https://<your-instance>.clerk.accounts.dev
# CLERK_FRONTEND_API=https://your-instance.clerk.accounts.dev

# Backend: Clerk Secret Key (starts with sk_)
# CLERK_SECRET_KEY=sk_test_your_secret_key_here

# Upload settings
MAX_UPLOAD_MB=10
ALLOW_PDF=true

# ==================== DATA PATHS ====================
# (Usually don't need to change these)

DATA_DIR=data
EMBEDDINGS_DIR=embeddings
INDEX_DIR=index

# ==================== MODEL SETTINGS ====================
# (Usually don't need to change these)

MODEL_NAME=vit_base_patch14_dinov2
EMB_DIM=768
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# FAISS index settings
FAISS_NLIST=4096
FAISS_M=16

# Search settings
TOPK_DEFAULT=50
PATCH_GRID=4

# ==================== FRONTEND (VITE) ====================
# Note: Vite requires VITE_ prefix for env vars

# API endpoint (local development)
VITE_API_BASE_URL=http://localhost:8000

# API endpoint (production - set this to your deployed backend URL)
# VITE_API_BASE_URL=https://your-api.render.com

# Optional auth token (must match STUDY_TOKEN if set)
# VITE_API_TOKEN=Bearer your-secure-token-here

# Clerk Authentication (frontend)
# Get from Clerk Dashboard → API Keys → Publishable Key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# PostHog Analytics (optional)
# VITE_POSTHOG_KEY=phc_your_project_api_key
# VITE_POSTHOG_HOST=https://us.i.posthog.com

