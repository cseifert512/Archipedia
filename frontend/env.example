# Frontend configuration (Vite)
#
# Render: set this env var in the Static Site settings, then redeploy (clear build cache).
# Local dev: you can set it in your shell before `npm run dev`.
VITE_API_BASE_URL=http://localhost:8000

# Optional auth token for protected backend routes (only needed if STUDY_TOKEN is set server-side)
# VITE_API_TOKEN=Bearer your_token_here

# Frontend configuration (Vite)
#
# Render: set this env var in the Static Site settings.
# Local dev: you can also define it in your shell before `npm run dev`.
VITE_API_BASE_URL=http://localhost:8000

# Optional auth token for the backend (if enabled)
# VITE_API_TOKEN=Bearer your_token_here


