# Frontend configuration (Vite)
#
# Render: set these env vars in the Static Site settings, then redeploy (clear build cache).
# Local dev: create a .env file in this directory with these variables.

# API Configuration
VITE_API_BASE_URL=http://localhost:8000

# Optional auth token for protected backend routes (only needed if STUDY_TOKEN is set server-side)
# VITE_API_TOKEN=Bearer your_token_here

# PostHog Analytics Configuration
# Get your Project API Key from: PostHog Dashboard → Project Settings → Project API Key
VITE_POSTHOG_KEY=phc_your_project_api_key_here

# Optional: PostHog instance URL (defaults to US cloud if not set)
# Options: https://us.i.posthog.com (US, default), https://eu.i.posthog.com (EU), or custom self-hosted URL
# VITE_POSTHOG_HOST=https://us.i.posthog.com

